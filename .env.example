# Provider AI. Default: "llm7" (30 RPM gratuito, senza chiave, modelli potenti).
# Opzioni keyless: llm7, pollinations, ovh
# Altre opzioni: openrouter (con chiave), ollama (locale)
LLM_PROVIDER=llm7

# Ordine di fallback per i provider keyless (separati da virgola).
KEYLESS_FALLBACK=llm7,pollinations,ovh

# Chiave personale per OpenRouter. Per i provider keyless non serve.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Endpoint OpenAI-compatible personalizzato (solo per openrouter/ollama).
# LLM_BASE_URL=http://localhost:11434/v1/chat/completions

# Modello per ruolo specifico; altrimenti usa il default del provider.
# NOVA_MODEL=
# ATLAS_MODEL=
# SIGMA_MODEL=
# COORDINATOR_MODEL=
