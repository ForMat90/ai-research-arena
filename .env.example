# Provider AI. Default: "llm7" (gratuito, senza chiave).
# Opzioni keyless: llm7, pollinations, ovh
# Altre opzioni: openrouter (con chiave), ollama (locale)
LLM_PROVIDER=llm7

# Ordine di fallback per i provider keyless (separati da virgola).
KEYLESS_FALLBACK=llm7,pollinations,ovh

# Modello per ogni provider della catena (vuoto = default del codice).
# LLM7_MODEL=default
POLLINATIONS_MODEL=openai-fast
# OVH_MODEL=

# Opzionale: chiave gratuita Groq (console.groq.com/keys).
# Se presente, Groq viene provato per primo; se si esaurisce passa a llm7, pollinations, ovh.
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Chiave personale per OpenRouter. Per i provider keyless non serve.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Endpoint OpenAI-compatible personalizzato (solo per openrouter/ollama).
# LLM_BASE_URL=http://localhost:11434/v1/chat/completions

# Modello per ruolo, solo per il provider principale (LLM_PROVIDER).
# NOVA_MODEL=
# ATLAS_MODEL=
# SIGMA_MODEL=
# COORDINATOR_MODEL=
